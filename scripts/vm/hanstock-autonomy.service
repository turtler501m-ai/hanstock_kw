[Unit]
Description=Hanstock Continuous Autonomous Strategy Service
After=network-online.target hanstock.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hanstock_kw
ExecStart=/home/ubuntu/hanstock_kw/.venv/bin/python -m src.autonomy_service
Restart=on-failure
RestartSec=15
Environment=PATH=/home/ubuntu/hanstock_kw/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AUTONOMY_RUNTIME_DIR=/home/ubuntu/hanstock_kw/.runtime/autonomy
EnvironmentFile=/home/ubuntu/hanstock_kw/.env

[Install]
WantedBy=multi-user.target
