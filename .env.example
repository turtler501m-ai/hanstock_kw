# Stock brokers for this Kiwoom deployment.
DOMESTIC_STOCK_BROKER=kiwoom

# Kiwoom REST API
MISTOCK_STOCK_BROKER=kiwoom
# Keep demo and live credentials separate. Start with demo until live trading is explicitly approved.
KIWOOM_TRADING_ENV=demo
KIWOOM_DOMESTIC_DEMO_ACCOUNT=
KIWOOM_DOMESTIC_DEMO_APP_KEY=
KIWOOM_DOMESTIC_DEMO_APP_SECRET=
KIWOOM_US_DEMO_ACCOUNT=
KIWOOM_US_DEMO_APP_KEY=
KIWOOM_US_DEMO_APP_SECRET=
KIWOOM_DOMESTIC_REAL_ACCOUNT=
KIWOOM_DOMESTIC_REAL_APP_KEY=
KIWOOM_DOMESTIC_REAL_APP_SECRET=
KIWOOM_US_REAL_ACCOUNT=
KIWOOM_US_REAL_APP_KEY=
KIWOOM_US_REAL_APP_SECRET=

# LS Securities API Settings
LS_API_ENABLED=false
LS_APP_KEY=your_ls_app_key
LS_APP_SECRET=your_ls_app_secret
LS_ACCOUNT_NO=your_ls_account_no
LS_TRADING_ENV=demo

# Execution mode
TRADING_ENV=demo
DRY_RUN=true
ENABLE_LIVE_TRADING=false
REQUIRE_APPROVAL=true
# true: block broker/market-data/AI/notification network access and show stored DB snapshots only.
ONLINE_ACCESS_BLOCKED=false

# Dashboard access protection. VM server binds to localhost by default.
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_AUTH_USERNAME=
DASHBOARD_AUTH_PASSWORD=

# Trading parameters
SPLIT_N=7
STOP_LOSS_PCT=-10
TAKE_PROFIT=30
RSI_BUY=30
RSI_SELL=70
TRAILING_STOP_ACTIVATION_PCT=10
TRAILING_STOP_PCT=6
TRAILING_STOP_LOOKBACK=20
TRADE_VALUE_SURGE_RATIO=1.5
FIRST_WAVE_MIN_PCT=12
FIRST_WAVE_PULLBACK_MIN_PCT=3
FIRST_WAVE_PULLBACK_MAX_PCT=12
# Read-only KR/US condition monitor refresh interval while either market is open.
CONDITION_MONITOR_INTERVAL_SECONDS=60
TOTAL_CAPITAL=10000000
# Display-only baseline for total account profit/loss. Does not affect order sizing.
ACCOUNT_INITIAL_CAPITAL=0
MAX_POSITIONS=3
MAX_SINGLE_WEIGHT=0.30
CASH_BUFFER=0.20
MAX_DAILY_LOSS_PCT=30.0
# Symbols rejected by the broker/simulation or otherwise unsafe for automated Hanstock orders.
HANSTOCK_EXCLUDED_SYMBOLS=
# Candidate scan source: yfinance (batch) or broker (Kiwoom/local chart cache).
CANDIDATE_SCAN_SOURCE=yfinance

# Notifications
HANSTOCK_API_SLACK=true
SLACK_WEBHOOK_URL=
MISTOCK_SLACK_WEBHOOK_URL=

# Mistock technical strategy
MISTOCK_TRAILING_STOP_ACTIVATION_PCT=10
MISTOCK_TRAILING_STOP_PCT=7
MISTOCK_TRAILING_STOP_LOOKBACK=20
MISTOCK_TRADE_VALUE_SURGE_RATIO=1.5
MISTOCK_FIRST_WAVE_MIN_PCT=12
MISTOCK_FIRST_WAVE_PULLBACK_MIN_PCT=3
MISTOCK_FIRST_WAVE_PULLBACK_MAX_PCT=12
TRADE_DB_PATH=.runtime/trades.sqlite
ACTIVE_MODEL_VERSION=v1
AI_STRATEGY_ENABLED=false
AI_SCORE_WEIGHT=0.40
AI_MIN_MODEL_CONFIDENCE=0.60
AI_REQUIRE_BACKTEST_PASS=true
AI_AUTO_APPROVE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=20
AI_CANDIDATE_LIMIT=5
# Keep OpenAI scoring serial by default to avoid rate-limit bursts.
AI_PREDICTION_MAX_WORKERS=1
BALANCE_FETCH_TIMEOUT_SECONDS=25

# Autonomous strategy platform. Disabled and approval-gated by default.
AUTONOMY_ENABLED=false
AUTONOMY_TRADING_ENV=demo
AUTONOMY_REQUIRE_APPROVAL=true
AUTONOMY_ENABLE_LIVE_TRADING=false
# Must be explicitly true in addition to all global real-trading guards.
AUTONOMY_LIVE_OPT_IN=false
# Continuous service stays idle while AUTONOMY_ENABLED=false. When enabling it,
# provide an audited factory returning ContinuousStrategyService.
AUTONOMY_SERVICE_FACTORY=
AUTONOMY_HEARTBEAT_SECONDS=30

# Mistock NASDAQ paper dashboard
MISTOCK_MARKET=NASDAQ
MISTOCK_TRADING_ENV=paper
MISTOCK_DRY_RUN=true
MISTOCK_ENABLE_LIVE_TRADING=false
MISTOCK_REQUIRE_APPROVAL=true
MISTOCK_TRADE_DB_PATH=.runtime/mistock/trades.sqlite
MISTOCK_TOTAL_CAPITAL=100000
MISTOCK_CURRENCY=USD
MISTOCK_EXCHANGE_MAP=
MISTOCK_CASH_BUFFER=0.20
MISTOCK_MAX_POSITIONS=5
MISTOCK_MAX_SINGLE_WEIGHT=0.25
MISTOCK_MAX_DAILY_LOSS_PCT=3.0
MISTOCK_MAX_DAILY_ORDERS=20
MISTOCK_REBUY_COOLDOWN_HOURS=24
MISTOCK_APPROVAL_EXPIRY_HOURS=24
MISTOCK_RATE_LIMIT_RETRIES=3
MISTOCK_RATE_LIMIT_BACKOFF_SECONDS=2
MISTOCK_SCAN_UNIVERSE_SIZE=60
MISTOCK_YFINANCE_TIMEOUT_SECONDS=10

# Telegram futures signal collector

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
